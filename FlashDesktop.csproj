<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- No WinForms: tray is a pure Shell_NotifyIconW implementation, which
         removes ~15MB of private bytes (red line 2, memory budget). -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlashDesktop</AssemblyName>
    <RootNamespace>FlashDesktop</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.5.0</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <Product>FlashDesktop</Product>
    <Description>FD desktop - 分类卡片面板 + 客户端 (S2-S5)</Description>
  </PropertyGroup>
</Project>
